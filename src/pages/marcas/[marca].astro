---
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import CTABloque from '../../components/CTABloque.astro';
import { marcasConSlug, productosDeMarca, buscarCategoria, capacidadKg } from '../../data/catalogo';
import { SITE_URL } from '../../data/sitio';

export function getStaticPaths() {
  return marcasConSlug.map((m) => ({ params: { marca: m.slug }, props: { nombre: m.nombre } }));
}

const { nombre } = Astro.props;
const { marca } = Astro.params;

const items = [...productosDeMarca(nombre)].sort((a, b) => (capacidadKg(a) ?? 9999) - (capacidadKg(b) ?? 9999));

// Agrupar por categoría hace navegable un listado que si no sería una lista plana de 60 modelos
const porCategoria = new Map<string, typeof items>();
for (const p of items) {
  const lista = porCategoria.get(p.categoria) ?? [];
  lista.push(p);
  porCategoria.set(p.categoria, lista);
}

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Equipos ${nombre}`,
    url: `${SITE_URL}/marcas/${marca}`,
  },
];
---

<Base
  title={`Equipos de Lavandería ${nombre} en Perú | Distribuidor Autorizado | Efameinsa`}
  description={`${items.length} equipos ${nombre} de lavandería industrial y comercial disponibles en Perú, con servicio técnico y repuestos en Lima.`}
  ruta={`/marcas/${marca}`}
  schema={schema}
  contextoWhatsApp={`equipos ${nombre}`}
>
  <Migas items={[{ nombre: 'Marcas', ruta: '/marcas' }, { nombre }]} />

  <header class="border-b border-gris-100 bg-gradient-to-b from-gris-50 to-white">
    <div class="contenedor py-12 sm:py-16">
      <h1 class="text-3xl font-bold sm:text-4xl">Equipos {nombre}</h1>
      <p class="prosa mt-4 max-w-3xl text-lg">
        {items.length} modelos {nombre} en catálogo, con instalación, puesta en marcha y repuestos atendidos por nuestro
        servicio técnico en Perú.
      </p>
    </div>
  </header>

  <div class="contenedor py-12">
    {
      [...porCategoria.entries()].map(([slugCat, lista]) => {
        const cat = buscarCategoria(slugCat);
        return (
          <section class="mb-14">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 class="text-2xl font-bold">{cat?.h1 ?? slugCat}</h2>
              {cat && (
                <a href={`/${cat.slug}`} class="text-sm font-semibold text-granate-500 hover:underline">
                  Ver todas las marcas de esta categoría →
                </a>
              )}
            </div>
            <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
              {lista.map((p) => (
                <TarjetaProducto producto={p} />
              ))}
            </div>
          </section>
        );
      })
    }
  </div>

  <CTABloque contexto={`equipos ${nombre}`} />
</Base>
