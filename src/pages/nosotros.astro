---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import CTABloque from '../components/CTABloque.astro';
import InsigniaISO from '../components/InsigniaISO.astro';
import { EMPRESA } from '../data/sitio';
import { productos, marcasConSlug } from '../data/catalogo';

const valores = [
  { titulo: 'Compromiso', texto: 'Asumimos el proyecto completo, no sólo la venta del equipo.' },
  { titulo: 'Calidad', texto: 'Procesos certificados bajo ISO 9001 en fabricación y servicio.' },
  { titulo: 'Responsabilidad ambiental', texto: 'ISO 14001: equipos y procesos orientados a menor consumo de agua y energía.' },
  { titulo: 'Cercanía', texto: 'Atención técnica directa, sin intermediarios entre el cliente y quien repara la máquina.' },
];
---

<Base
  title="Nosotros | Fabricante de Equipos de Lavandería Industrial en Perú | Efameinsa"
  description="Efameinsa S.A.: más de 26 años fabricando y distribuyendo equipos de lavandería industrial en Perú. Planta propia en Lima, certificaciones ISO 9001 e ISO 14001."
  ruta="/nosotros"
>
  <Migas items={[{ nombre: 'Nosotros' }]} />

  <header class="bg-gris-800 text-white">
    <div class="contenedor grid gap-10 py-14 sm:py-16 lg:grid-cols-2 lg:items-center lg:py-20">
      <div>
        <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
          Fabricamos en Lima los equipos que otros sólo importan
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-gris-100">
          Efameinsa S.A. nació en 2000 como taller de fabricación electromecánica. Hoy es una de las pocas empresas del
          rubro en Perú que combina planta propia con la representación de las marcas líderes del mundo.
        </p>
        <p class="mt-6 flex flex-wrap gap-3">
          <span class="inline-flex items-center rounded-full bg-gris-700 px-4 py-1.5 text-gris-200">
            <InsigniaISO norma="ISO 9001" detalle="Gestión de la calidad" />
          </span>
          <span class="inline-flex items-center rounded-full bg-gris-700 px-4 py-1.5 text-gris-200">
            <InsigniaISO norma="ISO 14001" detalle="Gestión ambiental" />
          </span>
        </p>
      </div>
      <figure class="overflow-hidden rounded-card shadow-2xl">
        <img
          src="/img/nosotros/fachada-efameinsa.webp"
          alt="Fachada de la planta de Efameinsa en Huachipa, Lima"
          width="768"
          height="531"
          fetchpriority="high"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
        <figcaption class="bg-gris-900/80 px-4 py-3 text-sm text-gris-200">
          Planta de fabricación y showroom en Huachipa, Lima
        </figcaption>
      </figure>
    </div>
  </header>

  <!-- Banda de cifras: la primera prueba de confianza tras el titular -->
  <section class="border-b border-gris-100 bg-gris-50">
    <dl class="contenedor grid grid-cols-2 gap-x-6 gap-y-8 py-10 text-center sm:grid-cols-4">
      <div>
        <dd class="text-4xl font-bold text-granate-500 sm:text-5xl">{EMPRESA.anios}</dd>
        <dt class="mt-2 text-xs font-semibold uppercase tracking-wider text-gris-500">Años de operación</dt>
      </div>
      <div>
        <dd class="text-4xl font-bold text-granate-500 sm:text-5xl">{productos.length}</dd>
        <dt class="mt-2 text-xs font-semibold uppercase tracking-wider text-gris-500">Modelos en catálogo</dt>
      </div>
      <div>
        <dd class="text-4xl font-bold text-granate-500 sm:text-5xl">{marcasConSlug.length}</dd>
        <dt class="mt-2 text-xs font-semibold uppercase tracking-wider text-gris-500">Marcas representadas</dt>
      </div>
      <div>
        <dd class="text-4xl font-bold text-granate-500 sm:text-5xl">2</dd>
        <dt class="mt-2 text-xs font-semibold uppercase tracking-wider text-gris-500">Certificaciones ISO vigentes</dt>
      </div>
    </dl>
  </section>

  <section class="contenedor py-14">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div class="prosa max-w-none text-base">
        <h2 class="text-2xl font-bold">Quiénes somos</h2>
        <p class="mt-4">
          Con más de {EMPRESA.anios} años de experiencia, Efameinsa se ha consolidado en la fabricación y distribución de
          equipos electromecánicos de tecnología avanzada, respaldados por las certificaciones ISO 9001 e ISO 14001.
          Contamos con una planta industrial equipada con maquinaria y herramientas para producir bajo estándares
          internacionales.
        </p>
        <p>
          Nuestra línea propia, <strong>Efamein</strong>, incluye calderas pirotubulares, centrífugas hidroextractoras,
          calandrias, mesas vaporizadoras, secadoras, lavadoras con barrera sanitaria y revisadoras de tela. Esa
          capacidad de fabricación nos permite adaptar un equipo al espacio real de una lavandería y garantizar
          repuestos sin depender de una importación.
        </p>
        <p>
          En paralelo representamos a fabricantes internacionales —UniMac, Primus, Girbau, ADC, Milnor, GMP, LG— para los
          procesos donde la tecnología importada aporta una ventaja clara. El cliente resuelve toda su lavandería con un
          solo proveedor y un solo servicio técnico.
        </p>

        <h2 class="mt-10 text-2xl font-bold">Misión</h2>
        <p class="mt-3">
          Proveer soluciones integrales de lavandería industrial que mejoren la productividad de nuestros clientes,
          reduciendo su consumo de agua y energía, con equipos confiables y servicio técnico oportuno.
        </p>

        <h2 class="mt-10 text-2xl font-bold">Visión</h2>
        <p class="mt-3">
          Ser la empresa de referencia en equipamiento de lavandería industrial en el Perú, reconocida por la calidad de
          su fabricación nacional y por el respaldo técnico que sostiene cada instalación.
        </p>
      </div>

      <aside class="space-y-6">
        <div class="rounded-card border border-gris-100 p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-gris-500">Certificaciones</h2>
          <ul class="mt-4 space-y-4 text-sm text-gris-700">
            <li class="flex items-start gap-3">
              <span class="text-granate-500"><InsigniaISO norma="ISO 9001" /></span>
              <span>Sistema de gestión de la calidad en fabricación, comercialización y servicio técnico.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-granate-500"><InsigniaISO norma="ISO 14001" /></span>
              <span>Sistema de gestión ambiental: equipos y procesos orientados al ahorro de agua y energía.</span>
            </li>
          </ul>
        </div>

        <div class="rounded-card bg-gris-50 p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-gris-500">Visítenos</h2>
          <p class="mt-3 text-sm leading-relaxed text-gris-700">
            Nuestro showroom mantiene equipos en exhibición y stock para entrega inmediata. Véalos funcionando antes de
            decidir su compra.
          </p>
          <address class="mt-4 text-sm not-italic leading-relaxed text-gris-700">
            {EMPRESA.direccion.calle}<br />
            {EMPRESA.direccion.distrito}, {EMPRESA.direccion.ciudad}
          </address>
          <p class="mt-3 text-sm text-gris-700">{EMPRESA.horario}</p>
          <a
            href="/contactenos"
            class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-granate-500 hover:underline"
          >
            Cómo llegar
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-gris-100 bg-gris-50 py-14">
    <div class="contenedor">
      <h2 class="text-2xl font-bold">Nuestros valores</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          valores.map((v) => (
            <li class="rounded-card bg-white p-6">
              <h3 class="text-lg font-semibold">{v.titulo}</h3>
              <p class="prosa mt-2 text-sm">{v.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTABloque titulo="¿Conversamos sobre su proyecto?" />
</Base>
