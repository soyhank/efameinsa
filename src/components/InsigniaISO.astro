---
/**
 * Insignia de certificación ISO con ícono de medalla. Hereda el color del
 * contexto (currentColor) para funcionar sobre fondos claros y oscuros.
 */
interface Props {
  norma: string;
  detalle?: string;
  class?: string;
}

const { norma, detalle, class: clase = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-1.5', clase]} title={detalle ? `${norma}: ${detalle}` : norma}>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="shrink-0"
  >
    <circle cx="12" cy="9" r="6.5"></circle>
    <path d="M9.5 8.8l1.8 1.9 3.4-3.6"></path>
    <path d="M8.6 14.5L7 22l5-2.8L17 22l-1.6-7.5"></path>
  </svg>
  <span class="text-xs font-bold tracking-wide">{norma}</span>
  {detalle && <span class="sr-only">{detalle}</span>}
</span>
