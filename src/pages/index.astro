---
import Base from '../layouts/Base.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import CTABloque from '../components/CTABloque.astro';
import HeroSlider from '../components/HeroSlider.astro';
import InsigniaISO from '../components/InsigniaISO.astro';
import { EMPRESA, SITE_URL } from '../data/sitio';
import { lineas, productos, productosDe, marcasConSlug } from '../data/catalogo';
import { sectores } from '../data/sectores';

const destacados = [
  'lavadora-industrial-uw45-unimac',
  'secadora-industrial-ug35-unimac',
  'lavadora-con-barrera-sanitaria-lbs50-efamein',
  'calandria-de-planchado-g14-25-gmp',
]
  .map((s) => productos.find((p) => p.slug === s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// Si algún destacado ya no existe en el catálogo, se completa con los primeros de la línea industrial
const vitrina = destacados.length >= 4 ? destacados : productosDe('lavadoras-industriales-en-venta-lima-peru').slice(0, 4);

const logosMarcas = ['unimac', 'primus', 'girbau', 'adc', 'milnor', 'gmp', 'lg', 'sailstar', 'bimap'];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: EMPRESA.nombre,
    url: SITE_URL,
    inLanguage: 'es-PE',
    publisher: { '@id': `${SITE_URL}/#organizacion` },
  },
];
---

<Base
  title="Lavadoras Industriales en Perú | Equipos de Lavandería | Efameinsa S.A."
  description="Fabricante y distribuidor de equipos de lavandería industrial y comercial en Perú. Lavadoras, secadoras, calandrias y calderas para hotelería, salud, minería y textil. ISO 9001 e ISO 14001."
  ruta="/"
  schema={schema}
>
  <!-- Portada -->
  <section class="relative overflow-hidden bg-gris-800 text-white">
    <div class="contenedor grid gap-12 py-16 lg:grid-cols-2 lg:items-center lg:py-24">
      <div>
        <p class="aparece mb-4 inline-flex flex-wrap items-center gap-x-3 gap-y-1 rounded-full bg-gris-700 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-gris-200">
          Fábrica propia en Lima
          <InsigniaISO norma="ISO 9001" detalle="Gestión de la calidad" />
          <InsigniaISO norma="ISO 14001" detalle="Gestión ambiental" />
        </p>
        <h1 class="aparece text-4xl font-bold leading-tight text-white sm:text-5xl">
          Equipamos lavanderías industriales que no pueden detenerse
        </h1>
        <p class="aparece-2 mt-6 max-w-xl text-lg leading-relaxed text-gris-100">
          {EMPRESA.anios} años fabricando y distribuyendo lavadoras, secadoras y equipos de planchado para hoteles,
          clínicas, campamentos mineros, plantas textiles y agroindustria en todo el Perú.
        </p>
        <div class="aparece-2 mt-8 flex flex-wrap gap-3">
          <a href="/cotizar" class="rounded-lg bg-granate-500 px-6 py-3.5 font-semibold text-white transition-colors hover:bg-granate-600">
            Solicitar cotización
          </a>
          <a
            href="/equipos-de-lavanderia"
            class="rounded-lg border border-gris-400 px-6 py-3.5 font-semibold text-white transition-colors hover:bg-gris-700"
          >
            Ver catálogo completo
          </a>
        </div>
        <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-gris-700 pt-8">
          <div>
            <dt class="text-xs uppercase tracking-wide text-gris-300">Experiencia</dt>
            <dd class="text-3xl font-bold text-white">{EMPRESA.anios}+</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-gris-300">Modelos</dt>
            <dd class="text-3xl font-bold text-white">{productos.length}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-gris-300">Marcas</dt>
            <dd class="text-3xl font-bold text-white">{marcasConSlug.length}</dd>
          </div>
        </dl>
      </div>

      <div class="aparece-3 hidden lg:block">
        <HeroSlider />
      </div>
    </div>
  </section>

  <!-- Diferencial: fabricantes con planta, representación oficial, stock y servicio propio -->
  <section class="border-b border-gris-100 py-14">
    <div class="contenedor grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <article>
        <h2 class="text-lg font-semibold">Fabricamos, no sólo importamos</h2>
        <p class="prosa mt-2 text-sm">
          Nuestra planta produce la línea Efamein: calderas, centrífugas, calandrias, mesas vaporizadoras y revisadoras de
          tela. Eso significa repuestos disponibles y equipos adaptables a su espacio.
        </p>
      </article>
      <article>
        <h2 class="text-lg font-semibold">Representantes oficiales</h2>
        <p class="prosa mt-2 text-sm">
          UniMac, Primus, Girbau, ADC, Milnor y GMP nos designaron representantes en el Perú. Comprar estas marcas aquí
          es comprarlas con respaldo de fábrica.
        </p>
      </article>
      <article>
        <h2 class="text-lg font-semibold">Stock para entrega inmediata</h2>
        <p class="prosa mt-2 text-sm">
          Mantenemos equipos en showroom y almacén propios. Donde otros cotizan 45 a 90 días de importación, nosotros
          podemos despachar de inmediato.
        </p>
      </article>
      <article>
        <h2 class="text-lg font-semibold">Servicio técnico propio</h2>
        <p class="prosa mt-2 text-sm">
          Instalación, puesta en marcha y mantenimiento con técnicos de la casa, en Lima y provincias. La máquina parada
          cuesta más que el repuesto.
        </p>
      </article>
    </div>
  </section>

  <!-- Sectores: entrada por intención de negocio -->
  <section class="contenedor py-16">
    <h2 class="text-3xl font-bold">¿Qué necesita lavar?</h2>
    <p class="prosa mt-3 max-w-2xl">
      La configuración correcta no depende del modelo de moda, sino del tipo de prenda y de los kilos que mueve al día.
    </p>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        sectores.map((s) => (
          <li>
            <a
              href={`/${s.slug}`}
              class="group flex h-full flex-col overflow-hidden rounded-card border border-gris-100 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-granate-500 hover:shadow-xl"
            >
              {s.imagen && (
                <div class="overflow-hidden border-b border-gris-100 bg-gris-50">
                  <img
                    src={s.imagen}
                    alt={`Equipos para ${s.nombre.toLowerCase()}`}
                    width="400"
                    height="300"
                    loading="lazy"
                    decoding="async"
                    class="mx-auto aspect-[4/3] w-full object-contain p-6 transition-transform duration-500 ease-out group-hover:scale-110"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-base font-semibold text-gris-800 transition-colors duration-300 group-hover:text-granate-500">
                  {s.nombre}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm text-gris-600">{s.entradilla}</p>
                <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-granate-500">
                  Ver soluciones
                  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Catálogo por línea -->
  <section class="border-y border-gris-100 bg-gris-50 py-16">
    <div class="contenedor">
      <h2 class="text-3xl font-bold">Catálogo de equipos</h2>
      <div class="mt-10 grid gap-10 lg:grid-cols-2">
        <div>
          <h3 class="mb-4 border-b border-gris-200 pb-3 text-sm font-bold uppercase tracking-wider text-granate-500">
            Línea industrial
          </h3>
          <ul class="grid gap-2 sm:grid-cols-2">
            {
              lineas.industrial.map((c) => (
                <li>
                  <a href={`/${c.slug}`} class="block rounded-lg bg-white px-4 py-3 text-sm font-medium text-gris-700 transition-colors hover:text-granate-500">
                    {c.h1}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="mb-4 border-b border-gris-200 pb-3 text-sm font-bold uppercase tracking-wider text-granate-500">
            Línea comercial
          </h3>
          <ul class="grid gap-2 sm:grid-cols-2">
            {
              lineas.comercial.map((c) => (
                <li>
                  <a href={`/${c.slug}`} class="block rounded-lg bg-white px-4 py-3 text-sm font-medium text-gris-700 transition-colors hover:text-granate-500">
                    {c.h1}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipos destacados -->
  <section class="contenedor py-16">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="text-3xl font-bold">Equipos más consultados</h2>
      <a href="/equipos-de-lavanderia" class="text-sm font-semibold text-granate-500 hover:underline">Ver catálogo completo →</a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {vitrina.slice(0, 4).map((p) => <TarjetaProducto producto={p} />)}
    </div>
  </section>

  <!-- Marcas -->
  <section class="border-t border-gris-100 py-14">
    <div class="contenedor">
      <h2 class="text-center text-sm font-bold uppercase tracking-wider text-gris-500">Marcas que representamos</h2>
      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-8">
        {
          logosMarcas.map((m) => (
            <li>
              <img
                src={`/img/marcas/${m}.png`}
                alt={m.toUpperCase()}
                height="40"
                loading="lazy"
                decoding="async"
                class="h-8 w-auto opacity-60 grayscale transition hover:opacity-100 hover:grayscale-0 sm:h-10"
              />
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-center">
        <a href="/marcas" class="text-sm font-semibold text-granate-500 hover:underline">Ver equipos por marca →</a>
      </p>
    </div>
  </section>

  <!-- Servicios -->
  <section class="contenedor py-16">
    <h2 class="text-3xl font-bold">Más que vender máquinas</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      <a href="/servicios/asesoria-en-proyectos-de-lavanderia" class="rounded-card border border-gris-100 p-6 transition-colors hover:border-granate-500">
        <h3 class="text-lg font-semibold">Proyectos de lavandería</h3>
        <p class="prosa mt-2 text-sm">
          Diseño del área, cálculo de carga, distribución de equipos e instalaciones de vapor, agua y desagüe.
        </p>
      </a>
      <a href="/servicios/asesoria-en-negocios-de-lavanderia" class="rounded-card border border-gris-100 p-6 transition-colors hover:border-granate-500">
        <h3 class="text-lg font-semibold">Asesoría de negocio</h3>
        <p class="prosa mt-2 text-sm">
          Para quien abre una lavandería: inversión, punto de equilibrio y elección de equipos según el mercado del local.
        </p>
      </a>
      <a href="/soporte-tecnico" class="rounded-card border border-gris-100 p-6 transition-colors hover:border-granate-500">
        <h3 class="text-lg font-semibold">Soporte técnico</h3>
        <p class="prosa mt-2 text-sm">
          Mantenimiento preventivo y correctivo, repuestos originales y atención en Lima y provincias.
        </p>
      </a>
    </div>
  </section>

  <!-- Puente a la página de proyectos: prueba social sin duplicar la galería completa -->
  <section class="border-t border-gris-100 bg-gris-50 py-14">
    <div class="contenedor flex flex-wrap items-center justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold sm:text-3xl">Proyectos realizados</h2>
        <p class="prosa mt-3">
          INEN, EsSalud Pasco, Hospital Regional del Cusco y dos hospitales adjudicados con UNOPS operan con equipos
          instalados por Efameinsa. Véalos funcionando.
        </p>
      </div>
      <a
        href="/proyectos"
        class="rounded-lg bg-granate-500 px-6 py-3.5 font-semibold text-white transition-colors hover:bg-granate-600"
      >
        Ver proyectos ejecutados
      </a>
    </div>
  </section>

  <CTABloque />
</Base>
