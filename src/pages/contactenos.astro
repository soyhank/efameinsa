---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import FormularioCotizacion from '../components/FormularioCotizacion.astro';
import { EMPRESA } from '../data/sitio';
---

<Base
  title="Contáctenos | Equipos de Lavandería Industrial y Comercial | Efameinsa"
  description="Contacte a Efameinsa S.A. en Lima: (01) 371-0006, WhatsApp 923 421 229 o central@efameinsa.com. Av. Los Cisnes Mz. H2 Lt. 18, Urb. Club de Huachipa."
  ruta="/contactenos"
>
  <Migas items={[{ nombre: 'Contacto' }]} />

  <div class="contenedor py-12">
    <h1 class="text-3xl font-bold sm:text-4xl">Contáctenos</h1>
    <p class="prosa mt-4 max-w-2xl text-lg">
      Puede llamarnos, escribirnos o visitarnos en nuestra planta. Le atenderemos y le mostraremos nuestra gama de
      equipos industriales y comerciales.
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <div class="space-y-6">
        <div class="rounded-card border border-marino-100 p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-marino-500">Teléfonos</h2>
          <ul class="mt-3 space-y-1.5">
            {
              EMPRESA.telefonos.map((t) => (
                <li>
                  <a href={`tel:+51${t.replace(/\D/g, '')}`} class="text-lg font-semibold text-marino-800 hover:text-marino-600">
                    {t}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={`tel:${EMPRESA.celular.replace(/\s/g, '')}`} class="text-lg font-semibold text-marino-800 hover:text-marino-600">
                {EMPRESA.celular}
              </a>
              <span class="ml-2 rounded bg-[#25D366]/15 px-2 py-0.5 text-xs font-semibold text-[#128C4A]">WhatsApp</span>
            </li>
          </ul>
        </div>

        <div class="rounded-card border border-marino-100 p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-marino-500">Correo</h2>
          <a href={`mailto:${EMPRESA.email}`} class="mt-3 block text-lg font-semibold text-marino-800 hover:text-marino-600">
            {EMPRESA.email}
          </a>
        </div>

        <div class="rounded-card border border-marino-100 p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-marino-500">Planta y oficinas</h2>
          <address class="mt-3 not-italic text-marino-700">
            {EMPRESA.direccion.calle}<br />
            {EMPRESA.direccion.distrito}, {EMPRESA.direccion.ciudad}, Perú
          </address>
          <p class="mt-3 text-sm text-marino-500">{EMPRESA.horario}</p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Av.+Los+Cisnes+Mz+H2+Lt+18+Urb.+Club+de+Huachipa+Lima"
            target="_blank"
            rel="noopener"
            class="mt-4 inline-block text-sm font-semibold text-marino-600 hover:underline"
          >
            Ver en Google Maps →
          </a>
        </div>
      </div>

      <FormularioCotizacion titulo="Escríbanos" contexto="Página de contacto" />
    </div>
  </div>
</Base>
