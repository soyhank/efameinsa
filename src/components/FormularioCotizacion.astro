---
import { EMPRESA, enlaceWhatsApp } from '../data/sitio';

interface Props {
  /** Producto o categoría desde la que se pide la cotización; viaja en el correo */
  contexto?: string;
  titulo?: string;
  compacto?: boolean;
}

const {
  contexto = '',
  titulo = 'Solicite una cotización',
  compacto = false,
} = Astro.props;
---

<div class:list={['rounded-card border border-marino-100 bg-white p-6', compacto ? '' : 'sm:p-8']}>
  <h2 class="text-xl font-bold sm:text-2xl">{titulo}</h2>
  <p class="mt-2 text-sm text-marino-600">
    Responde un asesor técnico, no un formulario automático. Le contactamos dentro del día hábil.
  </p>

  <form id="form-cotizacion" class="mt-6 grid gap-4 sm:grid-cols-2" novalidate>
    <input type="hidden" name="contexto" value={contexto} />
    <!-- Trampa para bots: un humano nunca rellena un campo oculto -->
    <div class="hidden" aria-hidden="true">
      <label for="empresa-web">No completar</label>
      <input type="text" id="empresa-web" name="empresa_web" tabindex="-1" autocomplete="off" />
    </div>

    <div>
      <label for="nombre" class="mb-1 block text-sm font-medium text-marino-800">Nombre y apellido *</label>
      <input
        type="text"
        id="nombre"
        name="nombre"
        required
        autocomplete="name"
        class="w-full rounded-lg border border-marino-200 px-3 py-2.5 text-sm focus:border-marino-600 focus:outline-none focus:ring-1 focus:ring-marino-600"
      />
    </div>

    <div>
      <label for="empresa" class="mb-1 block text-sm font-medium text-marino-800">Empresa</label>
      <input
        type="text"
        id="empresa"
        name="empresa"
        autocomplete="organization"
        class="w-full rounded-lg border border-marino-200 px-3 py-2.5 text-sm focus:border-marino-600 focus:outline-none focus:ring-1 focus:ring-marino-600"
      />
    </div>

    <div>
      <label for="telefono" class="mb-1 block text-sm font-medium text-marino-800">Teléfono / WhatsApp *</label>
      <input
        type="tel"
        id="telefono"
        name="telefono"
        required
        autocomplete="tel"
        inputmode="tel"
        class="w-full rounded-lg border border-marino-200 px-3 py-2.5 text-sm focus:border-marino-600 focus:outline-none focus:ring-1 focus:ring-marino-600"
      />
    </div>

    <div>
      <label for="email" class="mb-1 block text-sm font-medium text-marino-800">Correo *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="w-full rounded-lg border border-marino-200 px-3 py-2.5 text-sm focus:border-marino-600 focus:outline-none focus:ring-1 focus:ring-marino-600"
      />
    </div>

    <div class="sm:col-span-2">
      <label for="sector" class="mb-1 block text-sm font-medium text-marino-800">Sector</label>
      <select
        id="sector"
        name="sector"
        class="w-full rounded-lg border border-marino-200 bg-white px-3 py-2.5 text-sm focus:border-marino-600 focus:outline-none focus:ring-1 focus:ring-marino-600"
      >
        <option value="">Seleccione…</option>
        <option>Hotelería</option>
        <option>Clínica / Hospital</option>
        <option>Minería</option>
        <option>Textil</option>
        <option>Agroindustria</option>
        <option>Negocio de lavandería</option>
        <option>Otro</option>
      </select>
    </div>

    <div class="sm:col-span-2">
      <label for="mensaje" class="mb-1 block text-sm font-medium text-marino-800">
        ¿Qué necesita? *
      </label>
      <textarea
        id="mensaje"
        name="mensaje"
        rows="4"
        required
        placeholder="Ej.: hotel de 80 habitaciones, necesito equipar la lavandería completa."
        class="w-full rounded-lg border border-marino-200 px-3 py-2.5 text-sm focus:border-marino-600 focus:outline-none focus:ring-1 focus:ring-marino-600"
      ></textarea>
      <p class="mt-1.5 text-xs text-marino-500">
        Cuantos más kilos por día y tipo de prenda indique, más precisa será la propuesta.
      </p>
    </div>

    <div class="sm:col-span-2">
      <label class="flex items-start gap-2 text-xs text-marino-600">
        <input type="checkbox" name="acepta" required class="mt-0.5 rounded border-marino-300" />
        <span>
          Acepto la <a href="/politica-de-privacidad" class="underline hover:text-marino-600">política de privacidad</a> y
          el tratamiento de mis datos para atender esta solicitud.
        </span>
      </label>
    </div>

    <div class="sm:col-span-2">
      <button
        type="submit"
        class="w-full rounded-lg bg-coral-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-coral-600 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Enviar solicitud
      </button>
      <p id="form-estado" role="status" aria-live="polite" class="mt-3 text-sm"></p>
    </div>
  </form>

  <div class="mt-6 border-t border-marino-100 pt-5">
    <p class="text-sm text-marino-600">¿Prefiere hablar directamente?</p>
    <div class="mt-3 flex flex-wrap gap-3">
      <a
        href={enlaceWhatsApp(contexto)}
        target="_blank"
        rel="noopener"
        class="rounded-lg bg-[#25D366] px-4 py-2.5 text-sm font-semibold text-white hover:brightness-95"
      >
        WhatsApp
      </a>
      <a
        href={`tel:+51${EMPRESA.telefonos[0].replace(/\D/g, '')}`}
        class="rounded-lg border border-marino-300 px-4 py-2.5 text-sm font-semibold text-marino-700 hover:bg-marino-50"
      >
        {EMPRESA.telefonos[0]}
      </a>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('form-cotizacion') as HTMLFormElement | null;
  const estado = document.getElementById('form-estado');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    boton.disabled = true;
    boton.textContent = 'Enviando…';
    if (estado) {
      estado.textContent = '';
      estado.className = 'mt-3 text-sm';
    }

    try {
      const respuesta = await fetch('/api/cotizacion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const datos = await respuesta.json();

      if (respuesta.ok) {
        window.location.href = '/gracias';
        return;
      }
      if (estado) {
        estado.textContent = datos.mensaje ?? 'No pudimos enviar la solicitud. Escríbanos por WhatsApp.';
        estado.className = 'mt-3 text-sm text-coral-700';
      }
    } catch {
      if (estado) {
        estado.textContent = 'Hubo un problema de conexión. Escríbanos por WhatsApp y le atendemos ahora.';
        estado.className = 'mt-3 text-sm text-coral-700';
      }
    } finally {
      boton.disabled = false;
      boton.textContent = 'Enviar solicitud';
    }
  });
</script>
