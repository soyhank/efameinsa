---
import { EMPRESA, enlaceWhatsApp } from '../data/sitio';

interface Props {
  titulo?: string;
  texto?: string;
  contexto?: string;
}

const {
  titulo = '¿Necesita dimensionar su lavandería?',
  texto = 'Cuéntenos cuántos kilos de ropa mueve al día y le proponemos la configuración de equipos que le conviene, con costo de operación estimado.',
  contexto,
} = Astro.props;
---

<section class="bg-marino-800">
  <div class="contenedor py-14 text-center sm:py-16">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">{titulo}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-marino-200">{texto}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/cotizar"
        class="rounded-lg bg-coral-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-coral-600"
      >
        Solicitar cotización
      </a>
      <a
        href={enlaceWhatsApp(contexto)}
        target="_blank"
        rel="noopener"
        class="rounded-lg border border-marino-400 px-6 py-3 font-semibold text-white transition-colors hover:bg-marino-700"
      >
        Escribir por WhatsApp
      </a>
      <a
        href={`tel:+51${EMPRESA.telefonos[0].replace(/\D/g, '')}`}
        class="rounded-lg px-6 py-3 font-semibold text-marino-200 transition-colors hover:text-white"
      >
        {EMPRESA.telefonos[0]}
      </a>
    </div>
  </div>
</section>
