---
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import FormularioCotizacion from '../../components/FormularioCotizacion.astro';
import { servicios, buscarServicio } from '../../data/servicios';
import { SITE_URL } from '../../data/sitio';

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const servicio = buscarServicio(slug!)!;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: servicio.titulo,
    description: servicio.description,
    url: `${SITE_URL}${servicio.ruta}`,
    areaServed: { '@type': 'Country', name: 'Perú' },
    provider: { '@id': `${SITE_URL}/#organizacion` },
  },
];
---

<Base
  title={servicio.title}
  description={servicio.description}
  ruta={servicio.ruta}
  schema={schema}
  contextoWhatsApp={servicio.nombre}
>
  <Migas items={[{ nombre: 'Servicios', ruta: '/servicios' }, { nombre: servicio.nombre }]} />

  <header class="bg-marino-800 text-white">
    <div class="contenedor py-14 sm:py-20">
      <h1 class="max-w-3xl text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{servicio.titulo}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-marino-100">{servicio.entradilla}</p>
    </div>
  </header>

  <div class="contenedor py-14">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <ol class="space-y-8">
          {
            servicio.secciones.map((s, i) => (
              <li class="border-l-2 border-marino-200 pl-6">
                <span class="text-xs font-bold uppercase tracking-wider text-coral-600">Paso {i + 1}</span>
                <h2 class="mt-1 text-xl font-semibold">{s.titulo}</h2>
                <p class="prosa mt-2">{s.texto}</p>
              </li>
            ))
          }
        </ol>

        {
          servicio.entregables && (
            <div class="mt-12 rounded-card bg-marino-50 p-6">
              <h2 class="text-lg font-semibold">Qué recibe</h2>
              <ul class="mt-4 space-y-2 text-sm text-marino-700">
                {servicio.entregables.map((e) => (
                  <li class="flex gap-2">
                    <span class="text-marino-500" aria-hidden="true">
                      ✔
                    </span>
                    {e}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-32 lg:self-start">
        <FormularioCotizacion contexto={servicio.nombre} titulo="Solicitar este servicio" compacto />
      </aside>
    </div>
  </div>
</Base>
