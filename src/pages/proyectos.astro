---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import CTABloque from '../components/CTABloque.astro';
import ProyectosGaleria from '../components/ProyectosGaleria.astro';
import { proyectos } from '../data/proyectos';
import { SITE_URL } from '../data/sitio';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Proyectos de equipamiento de lavandería ejecutados por Efameinsa',
    itemListElement: proyectos.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.nombre,
      url: `${SITE_URL}/proyectos#${p.slug}`,
    })),
  },
];
---

<Base
  title="Proyectos Ejecutados | Lavanderías Hospitalarias Equipadas | Efameinsa"
  description="Lavanderías hospitalarias equipadas por Efameinsa en todo el Perú: INEN, EsSalud Pasco, Hospital Regional del Cusco y proyectos UNOPS en Abancay y La Libertad. Suministro, instalación y puesta en marcha."
  ruta="/proyectos"
  schema={schema}
>
  <Migas items={[{ nombre: 'Proyectos' }]} />

  <header class="bg-gris-800 text-white">
    <div class="contenedor py-14 sm:py-20">
      <h1 class="max-w-3xl text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        Proyectos que ya están lavando
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-gris-100">
        Hospitales e instituciones públicas de todo el Perú operan sus lavanderías con equipos suministrados, instalados
        y puestos en marcha por Efameinsa — varios de ellos adjudicados bajo estándares internacionales de contratación
        (UNOPS). Estas instalaciones son nuestra mejor carta de presentación: puede visitarlas funcionando.
      </p>
    </div>
  </header>

  <ProyectosGaleria />

  <section class="contenedor py-14">
    <div class="grid gap-8 sm:grid-cols-3">
      <article>
        <h2 class="text-lg font-semibold">Llave en mano</h2>
        <p class="prosa mt-2 text-sm">
          No entregamos cajas: entregamos lavanderías operando. Ingeniería, instalación de vapor, agua y desagüe, pruebas
          con carga real y capacitación del personal.
        </p>
      </article>
      <article>
        <h2 class="text-lg font-semibold">Estándares auditables</h2>
        <p class="prosa mt-2 text-sm">
          Adjudicaciones con UNOPS y entidades públicas exigen especificación técnica, plazos y garantías documentadas.
          Ese filtro lo pasamos en cada proyecto.
        </p>
      </article>
      <article>
        <h2 class="text-lg font-semibold">Respaldo posterior</h2>
        <p class="prosa mt-2 text-sm">
          Toda instalación queda cubierta por nuestro servicio técnico propio, con repuestos en Lima y atención en
          provincias. La entrega es el inicio de la relación, no el final.
        </p>
      </article>
    </div>
  </section>

  <CTABloque
    titulo="¿Su institución necesita una lavandería así?"
    texto="Cuéntenos el alcance de su proyecto — licitación, obra nueva o renovación de equipos — y le preparamos la propuesta técnica completa."
    contexto="un proyecto de equipamiento de lavandería institucional"
  />
</Base>
