---
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import CTABloque from '../../components/CTABloque.astro';
import { getCollection, render } from 'astro:content';
import { buscarCategoria } from '../../data/catalogo';
import { buscarSector } from '../../data/sectores';
import { SITE_URL, EMPRESA } from '../../data/sitio';

export async function getStaticPaths() {
  const articulos = await getCollection('blog');
  return articulos.map((a) => ({ params: { slug: a.id }, props: { articulo: a } }));
}

const { articulo } = Astro.props;
const { Content } = await render(articulo);

const formato = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long', year: 'numeric' });

// Los "relacionados" del frontmatter pueden ser categorías o sectores
const enlaces = articulo.data.relacionados
  .map((slug) => {
    const cat = buscarCategoria(slug);
    if (cat) return { nombre: cat.h1, ruta: `/${cat.slug}` };
    const sec = buscarSector(slug);
    if (sec) return { nombre: sec.titulo, ruta: `/${sec.slug}` };
    return null;
  })
  .filter((x): x is { nombre: string; ruta: string } => Boolean(x));

const otros = (await getCollection('blog'))
  .filter((a) => a.id !== articulo.id)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articulo.data.titulo,
    description: articulo.data.descripcion,
    datePublished: articulo.data.fecha.toISOString(),
    dateModified: (articulo.data.actualizado ?? articulo.data.fecha).toISOString(),
    author: { '@type': 'Organization', name: articulo.data.autor, url: SITE_URL },
    publisher: { '@id': `${SITE_URL}/#organizacion` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE_URL}/blog/${articulo.id}` },
    inLanguage: 'es-PE',
  },
];
---

<Base
  title={`${articulo.data.titulo} | ${EMPRESA.nombreCorto}`}
  description={articulo.data.descripcion}
  ruta={`/blog/${articulo.id}`}
  tipo="article"
  schema={schema}
>
  <Migas items={[{ nombre: 'Recursos', ruta: '/blog' }, { nombre: articulo.data.titulo }]} />

  <article class="contenedor py-12">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-wider text-coral-600">{articulo.data.categoria}</p>
      <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{articulo.data.titulo}</h1>
      <p class="mt-4 text-lg text-marino-600">{articulo.data.descripcion}</p>
      <p class="mt-5 border-b border-marino-100 pb-6 text-sm text-marino-500">
        {articulo.data.autor} · <time datetime={articulo.data.fecha.toISOString()}>{formato.format(articulo.data.fecha)}</time>
      </p>

      <div class="contenido-blog mt-8">
        <Content />
      </div>

      {
        enlaces.length > 0 && (
          <aside class="mt-12 rounded-card bg-marino-50 p-6">
            <h2 class="text-sm font-bold uppercase tracking-wider text-marino-500">Equipos relacionados</h2>
            <ul class="mt-4 flex flex-wrap gap-3">
              {enlaces.map((e) => (
                <li>
                  <a
                    href={e.ruta}
                    class="inline-block rounded-lg border border-marino-200 bg-white px-4 py-2.5 text-sm font-medium text-marino-700 hover:border-marino-600 hover:text-marino-600"
                  >
                    {e.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>

  {
    otros.length > 0 && (
      <section class="contenedor pb-12">
        <div class="mx-auto max-w-3xl">
          <h2 class="text-xl font-bold">Seguir leyendo</h2>
          <ul class="mt-5 space-y-3">
            {otros.map((a) => (
              <li>
                <a href={`/blog/${a.id}`} class="block rounded-lg border border-marino-100 p-4 hover:border-marino-600">
                  <span class="text-xs font-semibold uppercase tracking-wide text-coral-600">{a.data.categoria}</span>
                  <p class="mt-1 font-medium text-marino-800">{a.data.titulo}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CTABloque />
</Base>

